<?xml version="1.0" encoding="utf-8"?>
<!--
  Automatikus mentés és eszközök közötti átvitel (Android 12+).
  A titkosított jelszavakat tartalmazó fájlokat kizárjuk: a Keystore-kulcs nem költözik,
  így az új telefonon nem lennének visszafejthetők. Hordozható mentés: Beállítások > Export.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cameras.xml" />
        <exclude domain="sharedpref" path="ui.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cameras.xml" />
        <exclude domain="sharedpref" path="ui.xml" />
    </device-transfer>
</data-extraction-rules>
