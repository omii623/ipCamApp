<?xml version="1.0" encoding="utf-8"?>
<!--
  Automatikus mentés (Android 11 és régebbi).
  A kamerák és a legutóbbi belépés jelszavai az eszköz Keystore-kulcsával titkosítottak, a kulcs
  viszont NEM kerül át másik telefonra – ezért ezeket a fájlokat kizárjuk (különben az új telefonon
  vissza nem fejthető jelszavak lennének). Hordozható mentés: Beállítások > Export.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="cameras.xml" />
    <exclude domain="sharedpref" path="ui.xml" />
</full-backup-content>
